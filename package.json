{
  "name": "smpg-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "setup": "bun run scripts/setup.ts",
    "dev": "bun --filter @smpg/core dev",
    "build": "bun --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test"
  },
  "devDependencies": {
    "@clack/prompts": "^1.9.0",
    "@types/node": "^22.13.4",
    "picocolors": "^1.1.1",
    "tsup": "^9.0.0",
    "typescript": "^5.7.3"
  }
}
