# SMPG Core Environment Variables

# Base URL for customer hosted checkout and links
PUBLIC_BASE_URL="http://localhost:8787"

# State machine configuration
UNDO_WINDOW_SECONDS="90"
SUBMITTED_TTL_HOURS="72"
CREATED_TTL_MINUTES="60"
LATE_SUBMIT_HOURS="24"

# Telegram Bot Credentials
# Get bot token from @BotFather
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"

# Secret token sent by Telegram in X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET="your_telegram_webhook_secret_token_here"

# 256-bit encryption key (64 hex characters) used for AES-GCM encryption of merchant webhook secrets at rest
# Generate using: openssl rand -hex 32
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Optional: Pre-supplied bot info JSON to avoid getMe API network latency on worker cold start
# BOT_INFO='{"id":123456789,"is_bot":true,"first_name":"SMPG Payments Bot","username":"smpg_payments_bot"}'
